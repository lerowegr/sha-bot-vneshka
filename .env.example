# Python only. Never prefix BOT_TOKEN with VITE_.
BOT_TOKEN=
# Leave true on the server. compose.preview.yaml overrides it for UI-only testing.
BOT_POLLING_ENABLED=true
# Public HTTPS URL of the Mini App.
MINI_APP_URL=https://quiz.example.ru
# Production domain without scheme or path.
APP_DOMAIN=quiz.example.ru
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
QUIZ_DB_PATH=data/quiz.sqlite3
INIT_DATA_MAX_AGE=3600
# Host port used by Docker Compose. Keep 8080 unless it is occupied.
APP_PORT=8080
# Telegram user IDs allowed to use /admin (comma-separated). Empty = no admin access.
ADMIN_IDS=
# Optional; set before npm run build. Leave empty until the channel is known.
VITE_TELEGRAM_CHANNEL_URL=
